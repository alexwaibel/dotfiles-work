[user]
	name = {{ .name }}
	email = {{ .email }}

[credential "azrepos:org/{{ .ado.org }}"]
	username = {{ .email }}
	azureAuthority = https://login.microsoftonline.com/{{ .tenantId }}

[core]
	autocrlf = false
{{- if eq .chezmoi.os "windows" }}
	sshCommand = C:/Windows/System32/OpenSSH/ssh.exe
{{- else }}
	# known_hosts lives in ~/.ssh-agent (sandbox-readable) rather than ~/.ssh
	# (sandbox-denied), so git ssh can verify hosts inside the Copilot CLI sandbox.
	# Strict verification against the pre-seeded file; unknown hosts fail closed.
	sshCommand = ssh -o UserKnownHostsFile=~/.ssh-agent/known_hosts -o StrictHostKeyChecking=yes
{{- end }}

[credential]
	azreposCredentialType = oauth
	msauthUseBroker = true
	msauthUseDefaultAccount = true
{{- if eq .chezmoi.os "windows" }}
	helper = manager
{{- else }}
	helper = /mnt/c/Program\\ Files/Git/mingw64/bin/git-credential-manager.exe
{{- end }}

