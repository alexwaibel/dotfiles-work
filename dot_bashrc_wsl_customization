# WSL-specific shell customizations (managed by chezmoi).
# Sourced from ~/.bashrc so WSL-only tweaks stay out of the distro-provided
# ~/.bashrc. Add future WSL-only shell customizations here.

# Drop Windows PATH dirs this Linux user can't read. WSL appendWindowsPath
# mirrors the Windows PATH verbatim (incl. the ACL-locked
# 'Program Files\WindowsApps' and other users' profile dirs). The Copilot
# sandbox can't delegate those as readonly paths and aborts setup. Remove
# unreadable /mnt/c entries here; readable Windows tool dirs are kept.
if [ -n "$PATH" ]; then
  _clean=""
  while IFS= read -r _p; do
    [ -z "$_p" ] && continue
    case "$_p" in
      /mnt/c/*) [ -r "$_p" ] || continue ;;
    esac
    _clean="${_clean:+$_clean:}$_p"
  done < <(printf '%s' "$PATH" | tr ':' '\n')
  export PATH="$_clean"
  unset _clean _p
fi

# Put Doom Emacs' bin on PATH so `doom` (sync/doctor/upgrade) is available.
if [ -d "$HOME/.config/emacs/bin" ]; then
  case ":$PATH:" in
    *":$HOME/.config/emacs/bin:"*) ;;
    *) export PATH="$HOME/.config/emacs/bin:$PATH" ;;
  esac
fi

# Put the .NET SDK bin on PATH so `dotnet` is available.
if [ -d "$HOME/.dotnet" ]; then
  case ":$PATH:" in
    *":$HOME/.dotnet:"*) ;;
    *) export PATH="$HOME/.dotnet:$PATH" ;;
  esac
fi

# Auto-switch the active nvm Node version on `cd` based on the nearest .nvmrc,
# falling back to the default alias when none is found. Sourced after nvm loads
# in ~/.bashrc so the `nvm` function is available here.
if command -v nvm >/dev/null 2>&1; then
  cdnvm() {
    command cd "$@" || return $?
    nvm_path="$(nvm_find_up .nvmrc | command tr -d '\n')"

    # If there are no .nvmrc file, use the default nvm version
    if [[ ! $nvm_path = *[^[:space:]]* ]]; then

        declare default_version
        default_version="$(nvm version default)"

        # If there is no default version, set it to `node`
        # This will use the latest version on your machine
        if [ $default_version = 'N/A' ]; then
            nvm alias default node
            default_version=$(nvm version default)
        fi

        # If the current version is not the default version, set it to use the default version
        if [ "$(nvm current)" != "${default_version}" ]; then
            nvm use default
        fi
    elif [[ -s "${nvm_path}/.nvmrc" && -r "${nvm_path}/.nvmrc" ]]; then
        declare nvm_version
        nvm_version=$(<"${nvm_path}"/.nvmrc)

        declare locally_resolved_nvm_version
        # `nvm ls` will check all locally-available versions
        # If there are multiple matching versions, take the latest one
        # Remove the `->` and `*` characters and spaces
        # `locally_resolved_nvm_version` will be `N/A` if no local versions are found
        locally_resolved_nvm_version=$(nvm ls --no-colors "${nvm_version}" | command tail -1 | command tr -d '\->*' | command tr -d '[:space:]')

        # If it is not already installed, install it
        # `nvm install` will implicitly use the newly-installed version
        if [ "${locally_resolved_nvm_version}" = 'N/A' ]; then
            nvm install "${nvm_version}";
        elif [ "$(nvm current)" != "${locally_resolved_nvm_version}" ]; then
            nvm use "${nvm_version}";
        fi
    fi
  }

  alias cd='cdnvm'
  cdnvm "$PWD" || return $?
fi
