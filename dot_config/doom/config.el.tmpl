;;; config.el -*- lexical-binding: t; -*-

;; Personal Doom configuration, managed by chezmoi (rendered from config.el.tmpl).
;; Loaded after all modules. See `SPC h d v` to inspect any variable set here.

(setq user-full-name "{{ .name }}"
      user-mail-address "{{ .email }}")

;; --- Fonts -----------------------------------------------------------------
;; WSLg exposes the display over XWayland at a flat 96 DPI regardless of the
;; panel's real pixel density, so Emacs' default font renders tiny on a HiDPI
;; screen. Pin an explicit size; live-adjust with SPC : then
;; doom/increase-font-size, or bump :size here.
(setq doom-font (font-spec :family "DejaVu Sans Mono" :size 16))

;; --- which-key (leader popup) ----------------------------------------------
;;
;; Current Doom (v3-dev on master) only wires up which-key when `which-key-mode`
;; is fboundp *at byte-compile time* (`static-when` in lisp/doom-emacs.el),
;; because it assumes which-key is built into Emacs 30.1+. Ubuntu 24.04 ships
;; Emacs 29.3, where which-key is still an external package that isn't loaded at
;; compile time — so Doom silently compiles the whole which-key setup out and the
;; SPC leader popup never appears. Restore it ourselves. This is a no-op on
;; Emacs 30+ (the hook is idempotent and the package is already active there).
(when (require 'which-key nil t)
  (setq which-key-sort-order #'which-key-key-order-alpha
        which-key-sort-uppercase-first nil
        which-key-add-column-padding 1
        which-key-max-display-columns nil
        which-key-min-display-lines 6
        which-key-side-window-slot -10
        which-key-idle-delay 0.4)
  (add-hook 'doom-first-input-hook #'which-key-mode)
  (after! which-key
    (which-key-setup-side-window-bottom)))

;; --- Timezone ---------------------------------------------------------------
;;
;; This WSL distro runs on UTC (`/etc/localtime` -> Etc/UTC, no `TZ` set), which
;; the sandbox/base image leaves unconfigured. org-roam's daily-journal capture
;; stamps filenames with `%<%Y_%m_%d>` in *local* time, so an evening Pacific
;; entry (after 16:00–17:00 PT) was rolling onto the next UTC day and landing in
;; the wrong journal. Pin Emacs to Pacific; the zoneinfo name (not a fixed
;; "PST8") so DST (PST/PDT) is handled automatically. Scoped to Emacs so we
;; don't need root to touch the system clock.
(setenv "TZ" "America/Los_Angeles")

;; --- Notes / org-roam ------------------------------------------------------
;;
;; Notes live in the existing Logseq folder on OneDrive so the ~180 journals and
;; pages accumulated in Logseq carry over unchanged, and stay synced across
;; devices via OneDrive (we're migrating off Logseq's DB backend, not the notes).
;; Logseq already stored everything as plain `.org`, so no conversion is needed.
(setq org-directory "/mnt/c/Users/{{ .chezmoi.username }}/OneDrive - Microsoft/Documents/logseq/")

;; org-agenda-files defaults to just `org-directory`, and org only scans files
;; *directly* inside a listed directory — it never recurses. Every Logseq note
;; lives in the `journals/` and `pages/` subdirectories (the root itself has no
;; .org files), so the default agenda scanned an empty folder and listed no
;; TODOs. Point it at those two flat subdirectories instead; org re-expands the
;; directory entries on every agenda build, so new journals appear automatically.
(setq org-agenda-files (list (expand-file-name "journals/" org-directory)
                             (expand-file-name "pages/" org-directory)))

(setq org-roam-directory org-directory
      ;; Daily journals sit next to the old Logseq journals.
      org-roam-dailies-directory "journals/"
      ;; org-roam scans `org-roam-directory` recursively, which sweeps in
      ;; Logseq's internal `logseq/bak/` (150+ timestamped file backups) and
      ;; `logseq/.recycle/` (deleted-page trash). Those are frozen snapshots
      ;; from the Logseq era — parsing them on every db-sync is wasted work and
      ;; pollutes file-level queries. Exclude the whole Logseq-internal dir.
      ;; (Single alternation regexp so it works on older org-roam versions that
      ;; take a string rather than a list.)
      org-roam-file-exclude-regexp "/logseq/\\(bak\\|\\.recycle\\)/")

(after! org-roam
  ;; Emacs 29 ships with SQLite built in, so org-roam needs no native emacsql
  ;; binary. Force the builtin connector to avoid the legacy compile path.
  (setq org-roam-database-connector 'sqlite-builtin
        ;; Keep the binary DB OFF OneDrive — a cloud-synced sqlite file churns
        ;; constantly and risks corruption. Rebuildable cache, so local is fine.
        org-roam-db-location (expand-file-name "org-roam.db" doom-cache-dir)
        ;; New dailies match Logseq's `YYYY_MM_DD.org` naming so old and new
        ;; journals interleave cleanly in the same directory. The file-level
        ;; :ID: makes each daily an org-roam node, which is required for links
        ;; within it (e.g. to a Connect topic node) to register as backlinks.
        org-roam-dailies-capture-templates
        '(("d" "default" entry "* %?"
           :target (file+head "%<%Y_%m_%d>.org"
                              ":PROPERTIES:\n:ID:       %(org-id-new)\n:END:\n#+title: %<%Y-%m-%d>\n")))))
