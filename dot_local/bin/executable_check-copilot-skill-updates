#!/usr/bin/env python3

from __future__ import annotations

import hashlib
import sys
import urllib.error
import urllib.request
from pathlib import Path


SKILLS_DIR = Path.home() / ".copilot" / "skills"


def unquote(value: str) -> str:
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in {'"', "'"}:
        return value[1:-1]
    return value


def read_metadata(path: Path) -> dict[str, str]:
    lines = path.read_text(encoding="utf-8").splitlines()
    if not lines or lines[0] != "---":
        return {}

    metadata: dict[str, str] = {}
    in_metadata = False
    for line in lines[1:]:
        if line == "---":
            break
        if line == "metadata:":
            in_metadata = True
            continue
        if in_metadata:
            if not line.startswith("  "):
                break
            key, separator, value = line.strip().partition(":")
            if separator:
                metadata[key] = unquote(value)
    return metadata


def fetch_sha256(url: str) -> str:
    request = urllib.request.Request(
        url,
        headers={"User-Agent": "check-copilot-skill-updates/1.0"},
    )
    with urllib.request.urlopen(request, timeout=20) as response:
        return hashlib.sha256(response.read()).hexdigest()


def main() -> int:
    updates = 0
    errors = 0
    tracked = 0

    for skill_file in sorted(SKILLS_DIR.glob("*/SKILL.md")):
        metadata = read_metadata(skill_file)
        expected = metadata.get("x-origin-sha256")
        if not expected:
            continue

        tracked += 1
        name = skill_file.parent.name
        url = metadata.get("x-origin-url")
        if metadata.get("x-update-check") == "manual" or not url:
            version = metadata.get("x-origin-version", "unknown")
            source = metadata.get("x-origin-spec", metadata.get("x-origin-repository", "unknown"))
            print(f"MANUAL  {name}: {source} version {version}")
            continue

        try:
            current = fetch_sha256(url)
        except (OSError, urllib.error.URLError) as error:
            errors += 1
            print(f"ERROR   {name}: {error}")
            continue

        if current == expected:
            print(f"CURRENT {name}")
        else:
            updates += 1
            print(f"UPDATE  {name}")
            print(f"        source:   {url}")
            print(f"        recorded: {expected}")
            print(f"        current:  {current}")

    if tracked == 0:
        print(f"No tracked upstream skills found under {SKILLS_DIR}", file=sys.stderr)
        return 2

    print(f"\nTracked: {tracked} | Updates: {updates} | Errors: {errors}")
    if errors:
        return 2
    return 1 if updates else 0


if __name__ == "__main__":
    raise SystemExit(main())
