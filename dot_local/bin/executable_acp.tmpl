#!/usr/bin/env bash
#
# Launches Copilot in bounded autopilot with a narrow safe-tool allowlist.
#
# MCP availability and safe classifications come from
# ~/.local/share/chezmoi/.chezmoidata/mcp-tools.json. Run the audit-mcp-tools
# Copilot skill to compare that inventory with configured and live MCP surfaces.

set -euo pipefail

max_autopilot_continues="${ACP_MAX_AUTOPILOT_CONTINUES:-10}"

usage() {
  cat <<'EOF'
Usage: acp [COPILOT_ARGS...]

Environment:
  ACP_MAX_AUTOPILOT_CONTINUES    Autopilot continuation cap (default: 10).
EOF
}

if [[ "${1:-}" == "--acp-help" ]]; then
  usage
  exit 0
fi

if [[ ! "$max_autopilot_continues" =~ ^[1-9][0-9]*$ ]]; then
  echo "acp: ACP_MAX_AUTOPILOT_CONTINUES must be a positive integer" >&2
  exit 2
fi

safe_approvals=(
  'shell(jq:*)'
  'shell(date:*)'
  'shell(pwd)'
  'shell(ls:*)'
  'shell(cat:*)'
  'shell(head:*)'
  'shell(tail:*)'
  'shell(wc:*)'
  'shell(grep:*)'
  'shell(file:*)'
  'shell(stat:*)'
  'shell(diff:*)'
  'shell(cmp:*)'
  'shell(readlink:*)'
  'shell(realpath:*)'
  'shell(rg --no-config:*)'
  'shell(sort:*)'
  'shell(find:*)'
  'shell(git status:*)'
  'shell(git diff:*)'
  'shell(git log:*)'
  'shell(git blame:*)'
  'shell(git show:*)'
  'shell(git rev-parse:*)'
  'shell(git grep:*)'
  'shell(git ls-files:*)'
  'shell(git merge-base:*)'
  'shell(git rev-list:*)'
  'shell(git describe:*)'
  'shell(git remote -v)'
  'shell(git config --get:*)'
  'shell(git config --get-regexp:*)'
{{- range $server, $config := .mcpTools }}
{{- range $tool := $config.safe }}
  '{{ $server }}({{ $tool }})'
{{- end }}
{{- end }}
)

permission_args=(
  --autopilot
  --max-autopilot-continues
  "$max_autopilot_continues"
  --allow-tool=write
)
for approval in "${safe_approvals[@]}"; do
  permission_args+=("--allow-tool=${approval}")
done

exec {{ .mcpTool.command }} copilot "${permission_args[@]}" "$@"
