#!/usr/bin/env bash
# shellcheck disable=SC2016 # jq filters intentionally use single quotes.

set -euo pipefail

readonly PROGRAM="${0##*/}"
readonly DEFAULT_REPOS_ROOT="${HOME}/repos"
readonly DEFAULT_STATE_ROOT="${XDG_STATE_HOME:-${HOME}/.local/state}/sbx-work"

repos_root="${SBX_WORK_REPOS_ROOT:-$DEFAULT_REPOS_ROOT}"
state_root="${SBX_WORK_STATE_ROOT:-$DEFAULT_STATE_ROOT}"
dry_run=false

usage() {
  cat <<'EOF'
Usage:
  sbx-work [--dry-run] doctor [REPO]
  sbx-work [--dry-run] create WORK_ITEM SLUG [REPO]
  sbx-work run WORK_ITEM
  sbx-work status [WORK_ITEM]
  sbx-work [--dry-run] ado-exec WORK_ITEM -- COMMAND [ARG...]
  sbx-work [--dry-run] allow-network WORK_ITEM RULE [RULE...]
  sbx-work [--dry-run] import WORK_ITEM
  sbx-work [--dry-run] sync WORK_ITEM
  sbx-work [--dry-run] stop WORK_ITEM
  sbx-work [--dry-run] remove [--force] WORK_ITEM

Commands:
  doctor         Check host prerequisites, credentials, and Git access.
  create         Create a mountless VM with a VM-local Git clone and branch.
  run            Attach Copilot to an existing sandbox.
  status         Show persisted workflow state.
  ado-exec       Run one command with a process-scoped Azure Artifacts token.
  allow-network  Add sandbox-scoped network rules.
  import         Transfer committed VM work into a standard host worktree.
  sync           Transfer the rebased host branch back into the VM.
  stop           Stop the sandbox while preserving its filesystem.
  remove         Remove an exported sandbox. Refuses unexported work by default.

REPO defaults to the current Git repository name. Repository setup, test, and
validation commands intentionally remain the coding agent's responsibility.
EOF
}

die() {
  printf '%s: %s\n' "$PROGRAM" "$*" >&2
  exit 1
}

note() {
  printf '==> %s\n' "$*"
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

quote_command() {
  printf '%q ' "$@"
}

run() {
  if $dry_run; then
    printf '+ '
    quote_command "$@"
    printf '\n'
    return 0
  fi
  "$@"
}

find_sbx() {
  if [[ -n "${SBX_WORK_SBX_BIN:-}" ]]; then
    printf '%s\n' "$SBX_WORK_SBX_BIN"
    return
  fi
  if command -v sbx.exe >/dev/null 2>&1; then
    command -v sbx.exe
    return
  fi
  local windows_sbx="/mnt/c/Users/${USER}/AppData/Local/DockerSandboxes/bin/sbx.exe"
  [[ -x "$windows_sbx" ]] || die "sbx.exe not found; set SBX_WORK_SBX_BIN"
  printf '%s\n' "$windows_sbx"
}

validate_work_item() {
  [[ "$1" =~ ^[1-9][0-9]*$ ]] || die "work item must be a positive integer"
}

validate_slug() {
  [[ "$1" =~ ^[a-z0-9]+([a-z0-9-]*[a-z0-9])?$ ]] ||
    die "slug must contain lowercase letters, digits, and internal hyphens"
}

resolve_repo() {
  if [[ -n "${1:-}" ]]; then
    printf '%s\n' "$1"
    return
  fi
  local top
  top="$(git rev-parse --show-toplevel 2>/dev/null)" ||
    die "REPO is required outside a Git repository"
  basename "$top"
}

canonical_repo() {
  local path="${repos_root}/$1"
  [[ -d "$path/.git" ]] || die "canonical clone not found: $path"
  printf '%s\n' "$path"
}

discover_base_branch() {
  local repo_path="$1"
  local origin_head
  origin_head="$(
    git -C "$repo_path" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null ||
      true
  )"
  if [[ -n "$origin_head" ]]; then
    printf '%s\n' "${origin_head#origin/}"
    return
  fi
  if git -C "$repo_path" show-ref --verify --quiet refs/remotes/origin/main; then
    printf 'main\n'
    return
  fi
  if git -C "$repo_path" show-ref --verify --quiet refs/remotes/origin/master; then
    printf 'master\n'
    return
  fi
  local current_branch
  current_branch="$(git -C "$repo_path" branch --show-current)"
  [[ "$current_branch" == "main" || "$current_branch" == "master" ]] ||
    die "cannot discover the default branch"
  printf '%s\n' "$current_branch"
}

ensure_canonical_ready() {
  local repo_path="$1"
  local base_branch="$2"
  local current_branch
  current_branch="$(git -C "$repo_path" branch --show-current)"
  [[ "$current_branch" == "$base_branch" ]] ||
    die "canonical clone must be on $base_branch, found $current_branch"
  [[ -z "$(git -C "$repo_path" status --porcelain)" ]] ||
    die "canonical clone has local changes: $repo_path"
}

state_file() {
  printf '%s/%s.json\n' "$state_root" "$1"
}

read_state() {
  local file
  file="$(state_file "$1")"
  [[ -f "$file" ]] || die "state not found for work item $1"
  cat "$file"
}

state_value() {
  local id="$1"
  local query="$2"
  read_state "$id" | jq -er "$query"
}

write_state() {
  local id="$1"
  shift
  local file tmp
  file="$(state_file "$id")"
  mkdir -p "$state_root"
  tmp="${file}.tmp"
  jq -n "$@" >"$tmp"
  mv "$tmp" "$file"
}

update_state() {
  local id="$1"
  local filter="$2"
  shift 2
  local file tmp
  file="$(state_file "$id")"
  [[ -f "$file" ]] || die "state not found for work item $id"
  tmp="${file}.tmp"
  jq "$@" "$filter" "$file" >"$tmp"
  mv "$tmp" "$file"
}

win_path() {
  wslpath -w "$1"
}

sbx_exec_shell() {
  local sbx="$1"
  local sandbox="$2"
  local command="$3"
  run "$sbx" exec "$sandbox" -- bash -lc "$command"
}

ado_organization() {
  local repo_path="$1"
  local remote
  remote="$(git -C "$repo_path" remote get-url origin)"
  if [[ "$remote" =~ ^https://([^.]+)\.visualstudio\.com/ ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
    return
  fi
  if [[ "$remote" =~ ^https://dev\.azure\.com/([^/]+)/ ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
    return
  fi
  die "cannot derive Azure DevOps organization from origin: $remote"
}

doctor() {
  local repo
  repo="$(resolve_repo "${1:-}")"
  local repo_path sbx base_branch
  repo_path="$(canonical_repo "$repo")"
  sbx="$(find_sbx)"
  base_branch="$(discover_base_branch "$repo_path")"

  require_command git
  require_command jq
  require_command wslpath
  require_command azureauth
  ensure_canonical_ready "$repo_path" "$base_branch"

  note "Docker Sandboxes"
  run "$sbx" version
  run "$sbx" daemon status

  note "Copilot credential"
  if ! "$sbx" secret ls | grep -Eq '(^|[[:space:]])copilot([[:space:]]|$)'; then
    die "Copilot secret missing; run: sbx secret set copilot --command 'gh auth token'"
  fi

  note "Git authentication"
  run git -C "$repo_path" fetch --dry-run origin

  note "Repository"
  printf 'repo: %s\nbase: %s\npath: %s\n' "$repo" "$base_branch" "$repo_path"
}

create() {
  local id="$1"
  local slug="$2"
  local repo
  repo="$(resolve_repo "${3:-}")"
  validate_work_item "$id"
  validate_slug "$slug"

  local existing_state
  existing_state="$(state_file "$id")"
  [[ ! -e "$existing_state" ]] || die "state already exists: $existing_state"

  local repo_path sbx base_branch sandbox branch repo_dir
  repo_path="$(canonical_repo "$repo")"
  sbx="$(find_sbx)"
  base_branch="$(discover_base_branch "$repo_path")"
  sandbox="wi-${id}-vm"
  branch="users/alwaibel/agent/${id}-${slug}"
  repo_dir="/home/agent/workspace/${repo}"

  ensure_canonical_ready "$repo_path" "$base_branch"
  git -C "$repo_path" show-ref --verify --quiet "refs/heads/$branch" &&
    die "local branch already exists: $branch"
  git -C "$repo_path" show-ref --verify --quiet "refs/remotes/origin/$branch" &&
    die "remote branch already exists: $branch"

  if $dry_run; then
    note "dry-run create plan"
  else
    mkdir -p "$state_root"
  fi

  note "refreshing ${repo}/${base_branch}"
  run git -C "$repo_path" fetch origin
  run git -C "$repo_path" merge --ff-only "origin/$base_branch"
  local base_sha
  base_sha="$(git -C "$repo_path" rev-parse "$base_branch")"

  if ! $dry_run; then
    write_state "$id" \
      --arg id "$id" \
      --arg slug "$slug" \
      --arg repo "$repo" \
      --arg sandbox "$sandbox" \
      --arg branch "$branch" \
      --arg baseBranch "$base_branch" \
      --arg baseSha "$base_sha" \
      --arg repoDir "$repo_dir" \
      --arg status "creating" \
      '{
        workItem: $id,
        slug: $slug,
        repo: $repo,
        sandbox: $sandbox,
        branch: $branch,
        baseBranch: $baseBranch,
        baseSha: $baseSha,
        repoDir: $repoDir,
        status: $status
      }'
  fi

  local seed_bundle="${state_root}/${id}-seed.bundle"
  run git -C "$repo_path" bundle create "$seed_bundle" "$base_branch"
  run git -C "$repo_path" bundle verify "$seed_bundle"

  note "creating mountless sandbox $sandbox"
  run "$sbx" create --name "$sandbox" copilot
  run "$sbx" run -d --name "$sandbox"
  run "$sbx" cp "$(win_path "$seed_bundle")" "$sandbox:/tmp/${repo}.bundle"
  sbx_exec_shell "$sbx" "$sandbox" \
    "git clone --branch $(printf '%q' "$base_branch") /tmp/$(printf '%q' "$repo").bundle $(printf '%q' "$repo_dir") && git -C $(printf '%q' "$repo_dir") checkout -b $(printf '%q' "$branch")"
  run rm -f "$seed_bundle"

  if ! $dry_run; then
    update_state "$id" '.status = $status' --arg status "ready"
  fi
  note "ready: run 'sbx-work run $id'"
}

run_agent() {
  local id="$1"
  validate_work_item "$id"
  local sbx sandbox repo_dir
  sbx="$(find_sbx)"
  sandbox="$(state_value "$id" '.sandbox')"
  repo_dir="$(state_value "$id" '.repoDir')"
  printf 'After Copilot starts, run: /cwd %s\n' "$repo_dir"
  exec "$sbx" run --name "$sandbox"
}

show_status() {
  if [[ -n "${1:-}" ]]; then
    read_state "$1" | jq .
    return
  fi
  if [[ ! -d "$state_root" ]]; then
    printf 'No sbx-work state found.\n'
    return
  fi
  local found=false file
  shopt -s nullglob
  for file in "$state_root"/*.json; do
    found=true
    jq -r '[.workItem, .repo, .sandbox, .branch, .status] | @tsv' "$file"
  done
  shopt -u nullglob
  $found || printf 'No sbx-work state found.\n'
}

ado_exec() {
  local id="$1"
  shift
  [[ "${1:-}" == "--" ]] || die "ado-exec requires -- before COMMAND"
  shift
  (($# > 0)) || die "ado-exec requires COMMAND"
  validate_work_item "$id"

  local sbx sandbox repo repo_dir repo_path organization
  sbx="$(find_sbx)"
  sandbox="$(state_value "$id" '.sandbox')"
  repo="$(state_value "$id" '.repo')"
  repo_dir="$(state_value "$id" '.repoDir')"
  repo_path="$(canonical_repo "$repo")"
  organization="$(ado_organization "$repo_path")"

  if $dry_run; then
    printf '+ ADO_NPM_TOKEN=<redacted> '
    quote_command "$sbx" exec -e ADO_NPM_TOKEN "$sandbox" -- \
      bash -lc 'cd "$1" && shift && exec "$@"' bash "$repo_dir" "$@"
    printf '\n'
    return
  fi

  local token
  token="$(
    azureauth ado pat \
      --organization "$organization" \
      --display-name "DockerSandbox-wi-${id}" \
      --scope vso.packaging \
      --output token \
      --prompt-hint "DockerSandbox-wi-${id}" \
      --timeout 30
  )"
  ADO_NPM_TOKEN="$token" "$sbx" exec -e ADO_NPM_TOKEN "$sandbox" -- \
    bash -lc 'cd "$1" && shift && exec "$@"' bash "$repo_dir" "$@"
  unset token ADO_NPM_TOKEN
}

allow_network() {
  local id="$1"
  shift
  (($# > 0)) || die "allow-network requires at least one RULE"
  validate_work_item "$id"
  local sbx sandbox rule
  sbx="$(find_sbx)"
  sandbox="$(state_value "$id" '.sandbox')"
  for rule in "$@"; do
    run "$sbx" policy allow network --sandbox "$sandbox" "$rule"
  done
}

import_work() {
  local id="$1"
  validate_work_item "$id"
  local sbx sandbox repo branch base_branch base_sha repo_dir slug repo_path
  sbx="$(find_sbx)"
  sandbox="$(state_value "$id" '.sandbox')"
  repo="$(state_value "$id" '.repo')"
  branch="$(state_value "$id" '.branch')"
  base_branch="$(state_value "$id" '.baseBranch')"
  base_sha="$(state_value "$id" '.baseSha')"
  repo_dir="$(state_value "$id" '.repoDir')"
  slug="$(state_value "$id" '.slug')"
  repo_path="$(canonical_repo "$repo")"

  local vm_status
  vm_status="$("$sbx" exec "$sandbox" -- git -C "$repo_dir" status --porcelain)"
  [[ -z "$vm_status" ]] || die "sandbox repository has uncommitted changes"

  local vm_head
  vm_head="$("$sbx" exec "$sandbox" -- git -C "$repo_dir" rev-parse HEAD)"
  [[ "$vm_head" != "$base_sha" ]] || die "sandbox branch has no commits to import"

  local vm_bundle="/tmp/sbx-work-${id}.bundle"
  local host_bundle="${state_root}/${id}-import.bundle"
  sbx_exec_shell "$sbx" "$sandbox" \
    "cd $(printf '%q' "$repo_dir") && git bundle create $(printf '%q' "$vm_bundle") $(printf '%q' "$branch") ^$(printf '%q' "$base_sha") && git bundle verify $(printf '%q' "$vm_bundle")"
  run "$sbx" cp "$sandbox:$vm_bundle" "$(win_path "$host_bundle")"
  run git -C "$repo_path" bundle verify "$host_bundle"
  run git -C "$repo_path" fetch origin

  local worktree="${repos_root}/worktrees/${repo}/${id}-${slug}"
  if [[ ! -d "$worktree" ]]; then
    if git -C "$repo_path" show-ref --verify --quiet "refs/heads/$branch"; then
      run git -C "$repo_path" worktree add "$worktree" "$branch"
    else
      run git -C "$repo_path" worktree add "$worktree" -b "$branch" "origin/$base_branch"
    fi
  fi

  local import_ref="refs/remotes/sbx-work/${id}"
  run git -C "$worktree" fetch "$host_bundle" "$branch:$import_ref"
  run git -C "$worktree" merge --ff-only "$import_ref"
  run git -C "$worktree" rebase "origin/$base_branch"
  local imported_commit
  imported_commit="$(git -C "$worktree" rev-parse HEAD)"

  if ! $dry_run; then
    update_state "$id" \
      '.status = $status | .hostWorktree = $worktree | .importedCommit = $commit' \
      --arg status "imported" \
      --arg worktree "$worktree" \
      --arg commit "$imported_commit"
  fi
  note "imported to $worktree at $imported_commit"
}

sync_work() {
  local id="$1"
  validate_work_item "$id"
  local sbx sandbox branch base_sha repo_dir worktree
  sbx="$(find_sbx)"
  sandbox="$(state_value "$id" '.sandbox')"
  branch="$(state_value "$id" '.branch')"
  base_sha="$(state_value "$id" '.baseSha')"
  repo_dir="$(state_value "$id" '.repoDir')"
  worktree="$(state_value "$id" '.hostWorktree')"

  [[ -z "$(git -C "$worktree" status --porcelain)" ]] ||
    die "host worktree has uncommitted changes"
  [[ -z "$("$sbx" exec "$sandbox" -- git -C "$repo_dir" status --porcelain)" ]] ||
    die "sandbox repository has uncommitted changes"

  local bundle="${state_root}/${id}-sync.bundle"
  run git -C "$worktree" bundle create "$bundle" "$branch" "^$base_sha"
  run git -C "$worktree" bundle verify "$bundle"
  run "$sbx" cp "$(win_path "$bundle")" "$sandbox:/tmp/sbx-work-${id}-sync.bundle"
  sbx_exec_shell "$sbx" "$sandbox" \
    "cd $(printf '%q' "$repo_dir") && git fetch /tmp/sbx-work-${id}-sync.bundle $(printf '%q' "$branch"):refs/remotes/host/rebased && git reset --hard refs/remotes/host/rebased"

  local synced_commit
  synced_commit="$(git -C "$worktree" rev-parse HEAD)"
  if ! $dry_run; then
    update_state "$id" \
      '.status = $status | .syncedCommit = $commit' \
      --arg status "synced" \
      --arg commit "$synced_commit"
  fi
  run rm -f "$bundle"
  note "synced $synced_commit; run repository validation inside the VM"
}

stop_work() {
  local id="$1"
  validate_work_item "$id"
  local sbx sandbox
  sbx="$(find_sbx)"
  sandbox="$(state_value "$id" '.sandbox')"
  run "$sbx" stop "$sandbox"
  if ! $dry_run; then
    update_state "$id" '.status = $status' --arg status "stopped"
  fi
}

remove_work() {
  local force="$1"
  local id="$2"
  validate_work_item "$id"
  local sbx sandbox repo_dir imported_commit vm_head vm_status
  sbx="$(find_sbx)"
  sandbox="$(state_value "$id" '.sandbox')"
  repo_dir="$(state_value "$id" '.repoDir')"
  imported_commit="$(state_value "$id" '.importedCommit // empty' || true)"

  if [[ "$force" != "true" ]]; then
    [[ -n "$imported_commit" ]] ||
      die "sandbox has not been imported; use --force only to discard work"
    vm_status="$("$sbx" exec "$sandbox" -- git -C "$repo_dir" status --porcelain)"
    [[ -z "$vm_status" ]] || die "sandbox repository has uncommitted changes"
    vm_head="$("$sbx" exec "$sandbox" -- git -C "$repo_dir" rev-parse HEAD)"
    [[ "$vm_head" == "$imported_commit" ]] ||
      die "sandbox contains unexported commits; import again before removal"
  fi

  run "$sbx" rm --force "$sandbox"
  if ! $dry_run; then
    update_state "$id" '.status = $status' --arg status "removed"
  fi
}

while (($#)); do
  case "$1" in
    --dry-run)
      dry_run=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

command_name="${1:-}"
[[ -n "$command_name" ]] || {
  usage
  exit 2
}
shift

case "$command_name" in
  doctor)
    (($# <= 1)) || die "doctor accepts at most one REPO"
    doctor "${1:-}"
    ;;
  create)
    (($# >= 2 && $# <= 3)) || die "create requires WORK_ITEM SLUG [REPO]"
    create "$@"
    ;;
  run)
    (($# == 1)) || die "run requires WORK_ITEM"
    run_agent "$1"
    ;;
  status)
    (($# <= 1)) || die "status accepts at most one WORK_ITEM"
    show_status "${1:-}"
    ;;
  ado-exec)
    (($# >= 3)) || die "ado-exec requires WORK_ITEM -- COMMAND [ARG...]"
    ado_exec "$@"
    ;;
  allow-network)
    (($# >= 2)) || die "allow-network requires WORK_ITEM RULE [RULE...]"
    allow_network "$@"
    ;;
  import)
    (($# == 1)) || die "import requires WORK_ITEM"
    import_work "$1"
    ;;
  sync)
    (($# == 1)) || die "sync requires WORK_ITEM"
    sync_work "$1"
    ;;
  stop)
    (($# == 1)) || die "stop requires WORK_ITEM"
    stop_work "$1"
    ;;
  remove)
    force=false
    if [[ "${1:-}" == "--force" ]]; then
      force=true
      shift
    fi
    (($# == 1)) || die "remove requires [--force] WORK_ITEM"
    remove_work "$force" "$1"
    ;;
  *)
    die "unknown command: $command_name"
    ;;
esac
