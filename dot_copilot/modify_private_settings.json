{{- /* chezmoi:modify-template */ -}}
{{- $home := .chezmoi.homeDir -}}
{{- $settings := .chezmoi.stdin | default "{}" | fromJson -}}
{{- $readonlyPaths := list
  (printf "%s/.nvm" $home)
  "/proc/sys/kernel/random/uuid"
  (printf "%s/.copilot/hooks" $home)
  (printf "%s/.cache/copilot" $home)
  (printf "%s/.ssh-agent/known_hosts" $home)
-}}
{{- $readwritePaths := list
  "/tmp"
  (printf "%s/repos" $home)
  (printf "%s/.copilot/notes" $home)
  (printf "%s/.cache/chrome-debug-profile" $home)
  (printf "%s/.cache/chrome-devtools-mcp" $home)
  (printf "%s/.cache/fontconfig" $home)
  (printf "%s/.cache/google-chrome" $home)
  (printf "%s/.cache/mesa_shader_cache" $home)
  (printf "%s/.cache/ms-playwright" $home)
  (printf "%s/.npm" $home)
-}}
{{- $settings = $settings | setValueAtPath "version" 1 -}}
{{- $settings = $settings | setValueAtPath "hooks" (dict
  "preToolUse" (list (dict
    "type" "command"
    "bash" "if [[ ! -f ~/.copilot/hooks/guard-safe-shell.sh ]]; then printf '%s\\n' '{\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Required preToolUse hook is missing: ~/.copilot/hooks/guard-safe-shell.sh. Run chezmoi apply --force to restore it.\"}'; else exec bash ~/.copilot/hooks/guard-safe-shell.sh; fi"
    "timeoutSec" 5
  ))
) -}}
{{- $settings = $settings | setValueAtPath "sandbox" (dict
  "enabled" true
  "addCurrentWorkingDirectory" false
  "allowBypass" true
  "sandboxMcpServers" false
  "userPolicy" (dict
    "filesystem" (dict
      "readwritePaths" $readwritePaths
      "readonlyPaths" $readonlyPaths
      "deniedPaths" (list
        (printf "%s/.ssh" $home)
        (printf "%s/.aws" $home)
      )
      "clearPolicyOnExit" true
    )
    "network" (dict
      "allowOutbound" true
      "allowLocalNetwork" true
    )
  )
) -}}
{{- $settings = $settings | setValueAtPath "footer" (dict
  "showModelEffort" true
  "showDirectory" true
  "showBranch" true
  "showContextWindow" true
  "showQuota" false
  "showAiUsed" true
  "showAgent" true
  "showCodeChanges" false
  "showUsername" false
  "showSandbox" true
  "showCustom" true
) -}}
{{- $settings = $settings | setValueAtPath "model" "gpt-5.6-sol" -}}
{{- $settings = $settings | setValueAtPath "effortLevel" "default" -}}
{{- $settings = $settings | setValueAtPath "contextTier" "long_context" -}}
{{- $settings = $settings | setValueAtPath "allowedUrls" (list
  "https://learn.microsoft.com"
  "https://docs.github.com"
  "https://eng.ms"
  "https://westus2-2.in.applicationinsights.azure.com"
) -}}
{{- $settings = $settings | setValueAtPath "colorMode" "default" -}}
{{ $settings | toPrettyJson }}
